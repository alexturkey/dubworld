{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dublaj-hatti.invalid/schemas/transcript.schema.json",
  "type": "object",
  "title": "Transcript (dublaj-hatti/transcript@1)",
  "description": "Output of `dubla yaziya-dok` and `dubla hizala`. Segment/word layout is WhisperX-compatible.",
  "required": [
    "schema",
    "language",
    "segments"
  ],
  "properties": {
    "schema": {
      "const": "dublaj-hatti/transcript@1"
    },
    "language": {
      "type": "string",
      "description": "ISO 639-1 code, 'und' if unknown"
    },
    "engine": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "source file name (no directory)"
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "text"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "text": {
            "type": "string"
          },
          "speaker": {
            "type": "string"
          },
          "words": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/word"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "word": {
      "type": "object",
      "required": [
        "word",
        "start",
        "end"
      ],
      "properties": {
        "word": {
          "type": "string"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "score": {
          "type": "number"
        }
      }
    }
  }
}
