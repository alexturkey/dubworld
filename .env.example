# Ortam değişkenleri örneği / Environment variables example
#
# Bu dosyayı ".env" adıyla kopyalayın ve yalnız kullandığınız satırları doldurun. ".env" git'e girmez.
# Copy this file to ".env" and fill in only what you use. ".env" is git-ignored.
# Önerilen akış (yerel motorlar) HİÇBİR anahtar istemez. / The recommended flow needs NO keys.
# Bulut arka uçları veriyi ilgili hizmete gönderir: PRIVACY.md. / Cloud backends send data to the provider: PRIVACY.md.

# --- Bulut transkripsiyon / Cloud speech-to-text ---------------------------------------------------
ELEVENLABS_API_KEY=

# --- Çeviri API arka uçları / Translation API backends (ceviri.arka_uc) ---------------------------
# Adlar köprünün okuduğu adlardır; `dubla kontrol` aynı adlara bakar (src/dublaj_hatti/bolum_40_ceviri/arka_uc_secimi.py).
# Names are exactly what the translation bridge reads; `dubla kontrol` checks the same names.
# gemini_2_5_flash, gemini_3_1_flash_lite_tier_1, gemma_4_26b (tek anahtar / one key)
CODEX_BRIDGE_GEMINI_API_KEY=
# groq_llama_4_scout (ya da / or CODEX_BRIDGE_GROQ_API_KEY, GROQ_API_KEY, GROQ_API_KEY_2)
GROQ_API_KEY_1=
# mistral_nemo (ya da / or CODEX_BRIDGE_MISTRAL_API_KEY)
MISTRAL_API_KEY=
# cerebras_llama_3_1_8b (ya da / or CODEX_BRIDGE_CEREBRAS_API_KEY)
CEREBRAS_API_KEY=

# --- CLI çeviri arka uçları / CLI translation backends --------------------------------------------
# Codex CLI ve Claude Code CLI kendi oturumunuzla çalışır; anahtar gerekmez. Yalnız PATH'te değilse yol verin.
# Codex CLI and Claude Code CLI use your own login; no key. Set a path only if they are not on PATH.
CODEX_BRIDGE_CODEX_BIN=
CODEX_BRIDGE_CLAUDE_CLI=

# --- İsteğe bağlı yollar / Optional paths --------------------------------------------------------
# Çıktı klasörü (boşsa repo kökünde "cikti/") / Output folder (default: "cikti/" in the repo root)
DUBLAJ_OUTPUT_DIR=
# Ayar dosyası (boşsa ayarlar/kullanici.toml) / Settings file (default: ayarlar/kullanici.toml)
DUBLAJ_AYARLAR=
# Çalışma anında model indirmeye izin ver (varsayılan kapalı) / Allow model downloads at run time (default off)
DUBLAJ_CEVRIMICI=

# --- İsteğe bağlı özellikler / Optional features (docs/motorlar/) ---------------------------------
# Telegram botu (docs/tarifler/telegram_botu.md): BotFather belirteci + izinli sayısal kimlikler (virgülle).
# Telegram bot: BotFather token + allowed numeric user ids (comma separated). Empty list = bot does not start.
TELEGRAM_BOT_TOKEN=
TELEGRAM_IZINLI_KULLANICILAR=
# Büyük dosya (2000 MB'a kadar) için yerel Bot API sunucusu (docs/tarifler/telegram_buyuk_dosya.md):
# api_id ve api_hash my.telegram.org → API development tools sayfasından. Adres "dubla-telegram sunucu kur" ile yazılır;
# boşsa bulut Bot API (en çok 50 MB gönderme, 20 MB indirme).
# Local Bot API server for large files (up to 2000 MB): api_id / api_hash from my.telegram.org → API development tools.
# The address is written by "dubla-telegram sunucu kur"; empty = cloud Bot API (50 MB send, 20 MB download).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_YEREL_SUNUCU=
# Teslim biçimi: boş/video = önizlemeli video (varsayılan); belge = videoyu düz dosya olarak gönder.
# Delivery format: empty/video = video with preview (default); belge = send the video as a plain file.
TELEGRAM_TESLIM_BICIMI=
# RVC: resmî RVC WebUI klonu ve (gerekirse) onun python'u / official RVC WebUI clone and its python
DUBLAJ_RVC_KOK=
DUBLAJ_RVC_PYTHON=
# XTTS v2 ayrı sanal ortamda kuruluysa onun python'u / python of a separate XTTS environment
DUBLAJ_XTTS_PYTHON=
# gallery-dl yolu (PATH'te değilse) ve kendi gallery-dl ayar dosyanız / gallery-dl path and your own config file
DUBLAJ_GALLERY_DL=
DUBLAJ_GALLERY_DL_AYAR=
